# Nothing here is required. The site builds and runs with no keys at all.
# In GitHub Actions these are repository *variables* (Settings > Secrets and variables > Actions > Variables).
SITE_URL=https://theguysaccount.github.io/aligned-action-candidate-matcher
# Optional cookieless analytics endpoint, e.g. https://<code>.goatcounter.com/count
GOATCOUNTER_URL=
# Optional upkeep link in the footer (e.g. GitHub Sponsors). Never a candidate donation link.
SUPPORT_URL=
SUPPORT_LABEL=Support this project
